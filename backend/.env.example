# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=doctor_appointment_db
DB_USERNAME=root
DB_PASSWORD=

# Application Configuration
SERVER_PORT=8080
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:3000

# Upload Configuration
UPLOAD_PATH=./uploads

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_EXPIRATION=86400000

# Email Configuration (Gmail)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# SendGrid Configuration (Optional)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Your App Name

# Cloudinary Configuration (Optional)
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SePay Payment Gateway Configuration
SEPAY_MERCHANT_ID=YOUR_MERCHANT_ID
SEPAY_SECRET_KEY=YOUR_MERCHANT_SECRET_KEY
SEPAY_ENV=sandbox
SEPAY_CHECKOUT_URL=https://sandbox.sepay.vn/checkout
SEPAY_IPN_URL=http://localhost:8080/api/orders/sepay/ipn

# Production SePay Configuration
# SEPAY_ENV=production
# SEPAY_CHECKOUT_URL=https://sepay.vn/checkout
# SEPAY_IPN_URL=https://your-domain.com/api/orders/sepay/ipn
